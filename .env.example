# ---------------------------------------------------------------------------
# Le Chatbot Ardennais — variables d'environnement
# Copie ce fichier en `.env` pour `netlify dev`, et pose les mêmes variables
# dans Netlify > Site configuration > Environment variables en production.
# ---------------------------------------------------------------------------

# Anthropic — la clé ne quitte jamais les fonctions Netlify.
ANTHROPIC_API_KEY=sk-ant-...
# Modèle : claude-sonnet-5-5 (défaut) ou claude-haiku-5-5. Jamais de suffixe de date.
MODEL=claude-sonnet-5-5

# Supabase (projet en région EU). Les deux premières sont lues par le front,
# la troisième uniquement par les fonctions.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Quotas (dollars US). Voir README > Quotas.
MONTHLY_CREDIT_USD=100
PAID_RESERVE_USD=40
TRIAL_SOFT_CAP_USD=1
HARD_CAP_USD=5
PAID_MONTHLY_CAP_USD=15

# Emails autorisés sur /admin, séparés par des virgules.
ADMIN_EMAILS=toi@exemple.fr

# Stripe (optionnel). Sans STRIPE_SECRET_KEY, le paywall affiche « Me prévenir »
# et l'admin active les comptes à la main.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
